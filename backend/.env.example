NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:password@db:5432/prohire
REDIS_URL=redis://redis:6379
JWT_SECRET=changeme
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh
JWT_REFRESH_EXPIRES_IN=7d
# Dev default: Mailhog (docker-compose service `mailhog`) — no auth needed,
# view caught emails at http://localhost:8025. Leave SMTP_HOST empty to skip
# sending entirely. Point at a real provider (with SMTP_USER/SMTP_PASS) for
# production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@prohire.com
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
